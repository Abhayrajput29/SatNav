# Example names only. The Local First Webdev runtime should supply managed credentials.
# Keep real secrets in protected Webdev runtime configuration; never commit them.
HOST=127.0.0.1
PORT=3000
STRICT_PORT=true

# Managed database and platform service values (intentionally blank)
DATABASE_URL=
MANUS_PROJECT_ID=
MANUS_API_URL=
MANUS_API_KEY=
BUILT_IN_FORGE_API_KEY=
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=
MANUS_OAUTH_PORTAL_URL=

# No provider key is currently configured; NASA FIRMS is not connected.

# Optional local GDELT last-success cache. Default: .cache/satnav/gdelt-v1.json
# Only validated successful provider responses are cached; stale fallback is capped at 72 hours.
SATNAV_GDELT_CACHE_PATH=
